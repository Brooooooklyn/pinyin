+  let mut output = String::from_utf8(output).expect("empty output is valid UTF-8");
+  output.extend(
+    char::decode_utf16(input.iter().copied()).map(|c| c.unwrap_or(char::REPLACEMENT_CHARACTER)),
+  );
+  output
